# ==========================================
# Vessel Environment Configuration
# ==========================================

# 1. Relational Database (PostgreSQL via Prisma - Neon, Supabase, RDS, or Render Postgres)
DATABASE_URL="postgresql://vessel_user:vessel_password@localhost:5432/vessel?schema=public"

# 2. Session & Auth Security
SESSION_SECRET="your_super_secret_jwt_key_min_32_chars"
# Set to "true" when running on HTTPS / custom domains
COOKIE_SECURE="false"

# 3. AWS S3 / Object Storage (Persistent source of truth for project code)
S3_BUCKET="vessel-storage"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="us-east-1"
S3_ENDPOINT=""

# 4. Sandbox Execution Provider: "docker" (local/EC2 default) or "ecs" (AWS ECS Fargate)
SANDBOX_PROVIDER="docker"

# 4A. Local Docker Engine Configuration (Used when SANDBOX_PROVIDER="docker")
DOCKER_HOST=""
RUNNER_IMAGE="rikkyj/runner:latest"

# 4B. AWS ECS Fargate Configuration (Used when SANDBOX_PROVIDER="ecs")
ECS_CLUSTER="vessel-cluster"
ECS_TASK_DEFINITION="vessel-runner"
ECS_LAUNCH_TYPE="FARGATE"
# Comma-separated subnet IDs with outbound internet access (for pulling packages / S3)
ECS_SUBNETS="subnet-0123456789abcdef0,subnet-0abcdef0123456789"
# Security group allowing ports 3000 (app preview) and 3001 (runner daemon/PTY)
ECS_SECURITY_GROUPS="sg-0123456789abcdef0"

# 5. Distributed Deployment (Frontend on Vercel, Backend on Render)
# Frontend environment variables:
# NEXT_PUBLIC_RUNNER_WS_URL="https://vessel-backend.onrender.com"
# RENDER_BACKEND_URL="https://vessel-backend.onrender.com"

# Backend on Render environment variables:
# PORT=3000
# FRONTEND_URL="https://vessel.vercel.app"
