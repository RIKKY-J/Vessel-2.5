# ==============================================================
# Vessel Server (Render Backend) Environment Configuration
# ==============================================================

# Core Essentials (Required on Render):
DATABASE_URL="postgresql://user:password@host:5432/vessel?sslmode=require"
S3_BUCKET="vessel-storage"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"

# All of the following are 100% OPTIONAL and automatically defaulted:
# PORT=3000
# AWS_REGION="us-east-1"
# ECS_CLUSTER="vessel-cluster"
# ECS_TASK_DEFINITION="vessel-runner"
# ECS_LAUNCH_TYPE="FARGATE"
# ECS_SUBNETS=""           # Auto-discovered from AWS Default VPC if empty
# ECS_SECURITY_GROUPS=""   # Auto-discovered from AWS Default VPC if empty
